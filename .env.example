# Copy this file to .env before running docker compose.

# Public Gateway
PUBLIC_BASE_URL=https://rbi.example.com

# Gateway backend
APP_ENV=development
SECRET_KEY=change-me-generate-a-long-random-secret
TOKEN_HASH_SECRET=change-me-generate-a-different-long-random-secret
FIELD_ENCRYPTION_KEY=change-me-32-byte-url-safe-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
VIEWER_TOKEN_TTL_MINUTES=60
SESSION_IDLE_TIMEOUT_MINUTES=30
MAX_RUNNING_SESSIONS=20
MAX_RUNNING_SESSIONS_PER_USER=3
MANAGER_BASE_URL=http://cloakbrowser-manager:8080
CLOAK_MANAGER_AUTH_TOKEN=change-me-manager-internal-token

# PostgreSQL
POSTGRES_DB=rbi_gateway
POSTGRES_USER=rbi_gateway
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql+psycopg://rbi_gateway:change-me-postgres-password@postgres:5432/rbi_gateway

# Redis
REDIS_URL=redis://redis:6379/0

# CORS. Comma-separated origins for local development if needed.
ALLOWED_ORIGINS=https://rbi.example.com,http://localhost

# Logging
LOG_LEVEL=INFO
ACCESS_LOG_ENABLED=true
